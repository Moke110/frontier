[Unit]
Description=frontier Bitable sync (pull text edits, then mirror)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/frontier
Environment=FRONTIER_RUNTIME=%h/knowledge-loop
Environment=TZ=Asia/Shanghai
Environment=PATH=%h/.opencode/bin:%h/.npm-global/bin:%h/.local/bin:%h/miniconda3/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/frontier/env
ExecStart=__PYTHON__ -m knowledge.cli pull
ExecStart=__PYTHON__ -m knowledge.cli sync
ExecStart=-__PYTHON__ -m knowledge.cli compare
StandardOutput=journal
StandardError=journal
