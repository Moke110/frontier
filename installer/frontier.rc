#include <windows.h>
#ifndef VERSION_TEXT
#define VERSION_TEXT "0.1.0-preview.1"
#endif
#ifndef VERSION_NUMBERS
#define VERSION_NUMBERS 0,1,0,0
#endif
1 VERSIONINFO
FILEVERSION VERSION_NUMBERS
PRODUCTVERSION VERSION_NUMBERS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Frontier"
   VALUE "FileDescription", "Frontier Console"
   VALUE "FileVersion", VERSION_TEXT
   VALUE "ProductName", "Frontier"
   VALUE "ProductVersion", VERSION_TEXT
   VALUE "OriginalFilename", "Frontier.exe"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
